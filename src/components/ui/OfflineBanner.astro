---
// Offline warning bar (doc/extras.md §6): top-fixed, warning color, plain
// Spanish text, never blocks the sale. ui/ admission rule: props only — no
// fetch, no localStorage, no api/ imports (doc/astrobase.md §3.2).
//
// `visible` sets the INITIAL state at render time (SSR output). After load,
// islands/offline-banner.ts toggles the `hidden` attribute — the same
// contract utils/modal.ts already uses — so the markup stays owned here and
// ui/ never learns about the network.
//
// pointer-events-none (plan-sidebar.md Fase 4 decision): the bar is pure
// status text (no interactive content) and spans the full width at top-0 —
// without it, it would sit on top of the mobile sidebar toggle and swallow
// its clicks. Literal reading of extras.md §6: the bar NEVER blocks.
interface Props {
  visible?: boolean;
}
const { visible = false } = Astro.props;
---
<div
  data-offline-banner
  hidden={!visible}
  class="pointer-events-none fixed inset-x-0 top-0 z-50 bg-warning px-4 py-2 text-center text-base text-warning-content"
  role="status"
>
  Sin conexión — puedes seguir vendiendo
</div>
