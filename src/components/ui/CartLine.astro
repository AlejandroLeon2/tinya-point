---
// Cart line — SINGLE source of truth for a cart row (same template mechanism
// as ui/Card, option A plan-features Fase 2/3): inert markup cloned per item
// by islands/cart-actions.ts, which fills the [data-line-*] slots and sets
// data-cart-line="<id>" on each clone. Quantity/remove buttons carry data
// hooks only — no fixed ids (astrobase.md §3.4). ui/ rule: draws, never
// fetches (astrobase.md §1).

import Icon from "./Icon.astro";
---

<template data-cart-line-template>
  <li
    class="flex items-center gap-2 rounded-lg border border-border bg-surface p-2"
    data-cart-line=""
  >
    <div class="min-w-0 flex-1">
      <p data-line-name class="font-medium leading-tight text-text"></p>
      <p data-line-unit class="text-xs leading-tight text-gray-500"></p>
    </div>
    <div class="flex items-center gap-2">
      <div
        class="inline-flex items-center rounded-full border border-border bg-surface-muted p-px"
      >
        <button
          type="button"
          data-cart-qty-step="down"
          data-cart-action="step-down"
          aria-label="Restar una unidad"
          class="grid size-[22px] place-items-center rounded-full p-0 hover:bg-surface"
        >
          <Icon name="minus" class="block size-3" />
        </button>
        <input
          data-line-qty
          type="text"
          inputmode="numeric"
          value="1"
          aria-label="Cantidad"
          class="h-[22px] w-6 border-0 bg-transparent p-0 text-center text-[13px] font-medium tabular-nums
				focus:rounded-[5px] focus:bg-surface focus:outline-none"
        />
        <button
          type="button"
          data-cart-qty-step="up"
          data-cart-action="step-up"
          aria-label="Sumar una unidad"
          class="grid size-[22px] place-items-center rounded-full p-0 hover:bg-surface"
        >
          <Icon name="plus" class="block size-3" />
        </button>
      </div>

      <p
        data-line-importe
        class="w-24 shrink-0 text-right text-sm font-medium tabular-nums text-text"
      >
      </p>

      <button
        type="button"
        data-cart-remove
        data-cart-action="remove"
        aria-label="Quitar producto"
        class="grid size-7 shrink-0 place-items-center rounded-md p-0 text-text-muted hover:bg-red-500/10 hover:text-red-600"
      >
        <Icon name="trash-2" class="block size-4" />
      </button>
    </div>
  </li>
</template>
