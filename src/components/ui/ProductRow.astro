---
// Admin product row — SINGLE template cloned per product by
// islands/product-admin.ts (same mechanism as ui/HistorialLine.astro).
// State is never color-only (stilesbase §5.2): the badge carries the word
// "Activo"/"Inactivo" next to its tone, and the row's toggle button names
// its action. Deactivate opens the shared confirm modal (§5.5); restore is
// safe and direct. ui/ draws, never fetches or reads local data (astrobase §1).
---
<template data-product-row-template>
	<!-- md:hidden: ≥md shows the DataTable row (ProductRowDesktop template) -->
	<li
		class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-surface p-3 md:hidden"
		data-product-row=""
	>
		<span class="flex min-w-0 items-center gap-2">
			<!-- Admin thumbnail (plan-productos-v2.md Fase 4, D3): decorative
			     (the name beside it carries the meaning → alt=""), lazy, and
			     opacity-0 until it loads — same T4.4 fix as Card.astro:
			     display:none + lazy = la imagen nunca se descarga. Sin foto
			     (o URL rota) la isla colapsa el nodo con `hidden`. -->
			<img
				data-product-img
				alt=""
				loading="lazy"
				class="h-20 w-20  shrink-0 rounded-lg border border-border object-cover opacity-0"
			/>
			<span class="flex min-w-0 flex-col gap-1">
				<span data-product-nombre class="text-base font-semibold text-text"></span>
				<!-- Brand line — hidden ⇔ the product has no marca (island). -->
				<span data-product-marca hidden class="text-base text-text-muted"></span>
				<span class="flex flex-wrap items-center gap-3 text-base text-text-muted">
					<span data-product-precio class="font-bold text-text"></span>
					<span data-product-stock></span>
					<span
						data-product-badge
						class="inline-block rounded-full px-3 py-1 text-base font-semibold"
					></span>
				</span>
			</span>
		</span>
		<span class="flex flex-wrap gap-3">
			<button type="button" class="btn btn-secondary" data-product-edit="" data-product-action="edit">
				Editar
			</button>
			<button
				type="button"
				class="btn btn-danger"
				data-product-deactivate=""
				data-product-action="deactivate"
				data-modal-open="confirmar-desactivar"
			>
				Desactivar
			</button>
			<button type="button" class="btn btn-secondary" data-product-restore="" data-product-action="restore" hidden>
				Restaurar
			</button>
		</span>
	</li>
</template>
