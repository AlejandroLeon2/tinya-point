---
// Kbd (refactorUI §2.2 — Fase 1): visual shortcut hint (F2, F9) — desktop
// only at the call site (≥md, §4.2E). Pure draw.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---
<kbd
  class={`inline-flex min-w-8 items-center justify-center rounded-lg border border-border bg-bg px-2 py-0.5 text-base font-semibold text-text-muted ${cls}`}
>
  <slot />
</kbd>
