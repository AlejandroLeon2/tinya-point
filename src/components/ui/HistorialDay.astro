---
// Day group for the history (plan-mejoras-2.md Fase 3) — SINGLE template
// cloned per local day by islands/historial.ts. Native <details>/<summary>:
// the summary IS the day's purchase recap the owner asked for (fecha + "N
// ventas" + total + per-method breakdown in TEXT — stilesbase §5.2, never
// color alone). Only today's group starts open, first paint only (island
// rule). ui/ draws, never fetches or reads data (astrobase §1).
---
<template data-hist-day-template>
	<details
		data-hist-day=""
		class="rounded-lg border border-border bg-surface"
	>
		<summary
			class="flex cursor-pointer flex-col gap-1 p-3 text-base focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		>
			<span class="flex flex-wrap items-center justify-between gap-3">
				<span class="flex flex-wrap items-center gap-3">
					<span data-hist-dia class="font-semibold text-text"></span>
					<span data-hist-n class="text-text-muted"></span>
				</span>
				<span class="flex flex-wrap items-center justify-end gap-3">
					<span data-hist-desglose class="text-text-muted"></span>
					<span data-hist-total class="font-bold text-text"></span>
				</span>
			</span>
			<!-- "Productos más vendidos" of the day (base.md §7, plan-cierre
			     Fase 1) — TEXT line inside the recap, revealed by the island
			     only when the day has products with movement (stilesbase
			     §5.2: words carry the meaning, never color alone). -->
			<span data-hist-top class="text-text-muted" hidden>
				<span data-hist-top-texto></span>
			</span>
		</summary>
		<!-- Caja del día card (Fase 4): text-only summary of the local caja
		     session of this fecha_dia — revealed by the island when a record
		     exists (stilesbase §5.2: the words carry the meaning). -->
		<div data-hist-caja class="border-t border-border p-3 text-base text-text-muted" hidden>
			<span data-hist-caja-texto></span>
		</div>
		<ul data-hist-lines class="flex flex-col gap-3 border-t border-border p-3"></ul>
	</details>
</template>
