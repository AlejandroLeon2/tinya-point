---
// Visual modal shell: overlay, box, close button. Open/close and focus logic
// live in utils/modal.ts + islands/modal-controller.ts (doc/astrobase.md §3.2).
//
// Contract with modal-controller (keep in sync):
//   - root:         data-modal-root="<key>" + hidden + tabindex="-1"
//   - open trigger: data-modal-open="<key>"
//   - close button: data-modal-close (inside the modal)
interface Props {
	modalKey: string;
	title: string;
}
const { modalKey, title } = Astro.props;
---
<div
	data-modal-root={modalKey}
	hidden
	tabindex="-1"
	class="fixed inset-0 z-50 flex items-center justify-center bg-text/60 p-4"
>
	<div
		class="flex w-full max-w-md flex-col gap-4 rounded-xl border border-border bg-surface p-6"
		role="dialog"
		aria-modal="true"
		aria-label={title}
	>
		<div class="flex items-start justify-between gap-3">
			<h2 class="text-lg font-bold text-text">{title}</h2>
			<button type="button" class="btn btn-secondary" data-modal-close aria-label="Cerrar">
				✕
			</button>
		</div>
		<div class="text-base text-text"><slot /></div>
		<div class="flex flex-wrap justify-end gap-3"><slot name="actions" /></div>
	</div>
</div>
