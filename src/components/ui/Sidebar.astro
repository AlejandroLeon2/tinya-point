---
// Visual sidebar navigation — receives content via props/slots only
// (doc/astrobase.md §3.2): zero imports from api/, stores/ or
// utils/storage.ts. The caller (layouts/LayoutApp.astro) decides the items
// and the current path; this component only draws (doc/plan-sidebar.md Fase 1).
//
// Contract with islands/sidebar.ts (wired in Fase 3):
//   - root: data-sidebar-root — the toggle target of the mobile drawer.
interface NavItem {
	href: string;
	label: string;
}
interface Props {
	items: NavItem[];
	currentPath: string;
	/** So the mobile toggle can reference this nav via aria-controls (LayoutApp). */
	id?: string;
}
const { items, currentPath, id } = Astro.props;

// Normalize trailing slashes the same way islands/route-guard.ts does, so
// "/historial/" still marks exactly one item (plan-sidebar.md gotcha G3).
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const current = normalize(currentPath);
const isActive = (href: string) => normalize(href) === current;
---
<nav
	id={id}
	data-sidebar-root
	aria-label="Principal"
	class="sticky top-0 flex h-screen w-60 shrink-0 flex-col gap-4 overflow-y-auto border-r-2 border-border bg-surface p-4"
>
	<ul class="flex flex-col gap-2">
		{
			items.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={isActive(item.href) ? 'page' : undefined}
						class:list={[
							'flex min-h-14 items-center rounded-lg px-4 text-lg',
							// Active state never relies on color alone (stilesbase.md §5.2):
							// background + heavier weight + aria-current="page".
							isActive(item.href)
								? 'bg-primary font-bold text-primary-content'
								: 'font-semibold text-text hover:bg-bg active:bg-border',
							'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
						]}
					>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>

	{/* Bottom block: "Cerrar sesión" arrives via the named slot (LayoutApp). */}
	<div class="mt-auto flex flex-col gap-2">
		<slot name="footer" />
	</div>
</nav>

<style>
	/* Drawer visibility (doc/plan-sidebar.md Fase 3): the CSS media query
	   owns the BREAKPOINT (hidden below md, in-flow sticky at md+) so the
	   default state needs no JS — no pre-hydration flash, desktop correct
	   even if the island never loads. islands/sidebar.ts only toggles
	   data-sidebar-open: below md the drawer overlays the content as a
	   fixed panel (z-45: above the toggle button z-40, below banner/modals
	   z-50). Display toggling only — NEVER transform (gotcha G1: a
	   transformed ancestor breaks fixed descendants like the sync Modal). */
	@media (max-width: 767.98px) {
		nav:not([data-sidebar-open]) {
			display: none;
		}
		nav[data-sidebar-open] {
			position: fixed;
			top: 0;
			bottom: 0;
			left: 0;
			z-index: 45;
			box-shadow: 0 0 24px rgb(0 0 0 / 0.25);
		}
	}
</style>
