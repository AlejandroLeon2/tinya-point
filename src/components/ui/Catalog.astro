---
// Catalog section — presentational shell: big search input, category chips,
// stale notice, loading skeletons and the grid where the Card template
// renders (astrobase §3.2). Every interactive behavior belongs to
// islands/catalog.ts — this file only draws, props/DOM only (ui/ rule).
//
// refactorUI §4.2D (Fase 2):
//   - search: icon + big input + Kbd F2 (desktop), Esc clears, Enter adds a
//     unique result (island).
//   - categories: ChipGroup-style horizontal chips replace the old <select>
//     (hook data-catalog-category stays on the WRAPPER, data-category-value
//     on each chip; first chip "Todas" is static).
//   - stale: compact inline notice, no full-width block.
//   - skeleton: 8 cards while the first paint decision runs (island hides it
//     on the first render()).
import Icon from './Icon.astro';
import Kbd from './Kbd.astro';
import Skeleton from './Skeleton.astro';
---
<section class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-6">
	<!-- No h1 here anymore: the ONE page title ("Venta") is rendered by the
	     LayoutApp TopBar (refactorUI §3.1 Fase 1). -->

	<label class="flex flex-col gap-1 text-base font-semibold text-text">
		Buscar producto
		<span class="relative">
			<Icon
				name="buscar"
				class="pointer-events-none absolute left-3 top-1/2 h-6 w-6 -translate-y-1/2 text-text-muted"
			/>
			<input
				data-catalog-search
				class="input-field pl-11 pr-28"
				type="search"
				placeholder="Buscar por nombre…"
				autocomplete="off"
			/>
			<Kbd class="absolute right-3 top-1/2 hidden -translate-y-1/2 md:inline-flex">F2</Kbd>
		</span>
	</label>

	<!-- Category chips (§4.2D): wrapper KEEPS the data-catalog-category hook
	     (the island reads the selected data-category-value from it). First
	     chip is static "Todas"; the island clones the template per category. -->
	<div
		data-catalog-category
		role="group"
		aria-label="Categoría"
		class="flex items-center gap-2 overflow-x-auto py-1"
	>
		<button
			type="button"
			data-category-value=""
			aria-pressed="true"
			class="btn btn-secondary min-h-11 rounded-full px-4 py-2 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-content"
		>
			Todas
		</button>
	</div>
	<template data-category-chip-template>
		<button
			type="button"
			data-category-value=""
			aria-pressed="false"
			class="btn btn-secondary min-h-11 rounded-full px-4 py-2 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-content"
		>
			<span data-chip-label></span>
		</button>
	</template>

	<!-- "Catálogo desactualizado" — compact inline notice (§4.2D: text set by
	     the island with formatNumero; hidden until the cache is stale and
	     could not be refreshed). -->
	<div data-catalog-stale hidden class="flex flex-wrap items-center gap-2 text-base text-text-muted">
		<p data-catalog-stale-text></p>
		<button
			data-catalog-refresh
			type="button"
			class="btn btn-secondary min-h-11 px-3 py-1.5 text-base"
		>
			Actualizar
		</button>
	</div>

	<div data-catalog-empty-area class="flex flex-col gap-4">
		<slot name="empty" />
	</div>

	<!-- Loading skeletons (§4.2D / T2.9): visible from build until the island
	     finishes the first render() — no premature EmptyState flash. -->
	<div
		data-catalog-skeleton
		class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4"
		aria-hidden="true"
	>
		{
			Array.from({ length: 8 }).map(() => (
				<div class="flex flex-col gap-3">
					<Skeleton class="aspect-[4/3]" />
					<Skeleton class="h-6 w-3/4" />
					<Skeleton class="h-6 w-1/3" />
				</div>
			))
		}
	</div>

	<div
		data-catalog-grid
		class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4"
	>
		<slot />
	</div>

	<!-- Visual pagination, 50/page, client-only (plan-productos-v2 D1): the
	     island hides it until there is more than one page. No fixed ids —
	     data-attribute hooks only (islands rule). -->
	<nav
		data-catalog-pagination
		hidden
		aria-label="Paginación del catálogo"
		class="flex items-center justify-between gap-3"
	>
		<button data-catalog-prev type="button" class="btn btn-secondary">Anterior</button>
		<p data-catalog-range aria-live="polite" class="text-base text-text-muted"></p>
		<button data-catalog-next type="button" class="btn btn-secondary">Siguiente</button>
	</nav>
</section>
