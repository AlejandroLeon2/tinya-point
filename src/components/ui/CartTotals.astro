---
// Totals block (visual, plan-features Fase 3 deviation "totales"): the smart
// passes formatted values and the tax label as PROPS; islands/cart-actions.ts
// keeps the [data-cart-*] hooks in sync with stores/cart.ts (astrobase.md
// §3.2 — ui/ only draws what it is handed).
interface Props {
	subtotal?: string;
	impuesto?: string;
	total?: string;
	taxLabel?: string;
}
const {
	subtotal = 'S/ 0.00',
	impuesto = 'S/ 0.00',
	total = 'S/ 0.00',
	taxLabel = 'Impuesto',
} = Astro.props;
---
<dl class="flex flex-col gap-1.5 rounded-lg border border-border bg-surface p-3.5 text-sm">
	<div class="flex justify-between gap-3">
		<dt class="text-text-muted">Subtotal</dt>
		<dd data-cart-subtotal class="font-medium tabular-nums text-text">{subtotal}</dd>
	</div>
	<div class="flex justify-between gap-3">
		<!-- data-cart-tax-label: islands overwrite the build-time default with
		     the configured IGV rate (plan-productos-v2.md Fase 5). -->
		<dt data-cart-tax-label class="text-text-muted">{taxLabel}</dt>
		<dd data-cart-impuesto class="font-medium tabular-nums text-text">{impuesto}</dd>
	</div>
	<div class="mt-1 flex justify-between gap-3 border-t border-border pt-2 text-2xl font-bold">
		<dt class="self-center text-text">Total</dt>
		<dd data-cart-total class="tabular-nums text-text">{total}</dd>
	</div>
</dl>
