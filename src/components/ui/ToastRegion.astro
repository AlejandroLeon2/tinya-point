---
// ToastRegion (refactorUI §2.2 — Fase 1): the fixed stack + the clone
// template. Rendered ONCE per page by LayoutApp; islands show messages
// through utils/toast.ts (mostrarToast). aria-live=polite announces without
// stealing focus (§12); fixed top-right under the TopBar → zero layout shift
// (D9). pointer-events-none: toasts never block the cashier.
import Toast from './Toast.astro';
---
<div
  data-toast-region
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed right-4 top-20 z-50 flex flex-col items-end gap-2"
>
  <template data-toast-template>
    <Toast />
  </template>
</div>
