---
// Icon (refactorUI §2.2 — Fase 1): the single home for inline SVG icons —
// stroke="currentColor", 24×24, decorative (aria-hidden; the visible text
// label always accompanies it — §0.9). Zero dependencies (§12): the paths
// live in this static map, set:html only ever receives THEM, never data.
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'h-6 w-6' } = Astro.props;

const icons: Record<string, string> = {
  // POS / banknote
  venta:
    '<rect x="2.5" y="6.5" width="19" height="11" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/>',
  // clock
  historial: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
  // clock (plain — the caja header pill, refactorUI §5)
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
  // wallet
  caja: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 9.5h18"/><path d="M16 14.5h2"/>',
  // box
  productos:
    '<path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4v-9Z"/><path d="M3.5 7.5 12 11.5l8.5-4M12 11.5v9"/>',
  // tag
  categorias:
    '<path d="M3 11.5V5a2 2 0 0 1 2-2h6.5a2 2 0 0 1 1.4.6l7.5 7.5a2 2 0 0 1 0 2.8l-6.5 6.5a2 2 0 0 1-2.8 0L3.6 12.9a2 2 0 0 1-.6-1.4Z"/><path d="M7.5 7.5h.01"/>',
  // layers
  stock: '<path d="m12 3 8.5 4.7L12 12.4 3.5 7.7 12 3Z"/><path d="M3.5 12.3 12 17l8.5-4.7"/>',
  // gear
  ajustes:
    '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8"/>',
  // ellipsis (TabBar "Más")
  mas: '<path d="M6 12h.01M12 12h.01M18 12h.01"/>',
  // hamburger (TopBar Menú)
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  // check (Toast, StatusPill)
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  // refresh / sync
  sync: '<path d="M20.5 12a8.5 8.5 0 1 1-2.5-6"/><path d="M20.5 4.5V10H15"/>',
  // wifi on / off (TopBar net pill)
  wifi: '<path d="M4.5 10.5a11 11 0 0 1 15 0"/><path d="M8 14a6 6 0 0 1 8 0"/><path d="M12 17.5h.01"/>',
  'wifi-off':
    '<path d="M3 3l18 18"/><path d="M8 14a6 6 0 0 1 5.5-1.6"/><path d="M12 17.5h.01"/>',
  // chevrons (sidebar collapse toggle)
  'chevron-left': '<path d="m14 6-6 6 6 6"/>',
  'chevron-right': '<path d="m10 6 6 6-6 6"/>',
  // magnifier (POS search — refactorUI §4.2D)
  buscar: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
  // microphone (voice search — plan-speak-search.md Fase 1)
  mic: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/>',
  // credit card / phone (payment methods — refactorUI §4.2E)
  tarjeta: '<rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 10h19"/>',
  celular: '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M10.5 18.5h3"/>',
  // cart (mobile cart bar — refactorUI §4.2C)
  carrito:
    '<path d="M3 4h2l2.4 10.4a1.5 1.5 0 0 0 1.5 1.1h7.9a1.5 1.5 0 0 0 1.5-1.1L20 8H6"/><circle cx="9.5" cy="19" r="1.2"/><circle cx="17" cy="19" r="1.2"/>',
  // plus (primary action "+ Nuevo producto" — refactorUI §7)
  plus: '<path d="M12 5v14M5 12h14"/>',
};

const inner = icons[name] ?? '';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={inner}
></svg>
