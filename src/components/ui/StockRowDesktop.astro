---
// Desktop stock row — SINGLE template cloned per product into the
// ui/DataTable tbody by islands/stock/stock.ts, the desktop twin of
// ui/StockRow.astro (same data hooks → ONE paintRow(), the ProductRow ↔
// ProductRowDesktop pattern). Columns: Producto · Categoría · Estado ·
// Precio · Ajuste — category in its own column and the status tag (Estado)
// in ANOTHER one (owner request 2026-11-01), out of the product name cell.
// Controls (owner request 2026-11-01): stepper = ± icon buttons + direct
// number input ONLY (batch +5/+10/+24 removed), "Guardar" on the side
// commits the input over the stock — no auto-save debounce.
// ui/ draws, never fetches or reads local data (astrobase §1).
import Icon from './Icon.astro';
---
<template data-stock-row-desktop-template>
	<tr class="hidden border-b border-border md:table-row" data-stock-row="">
		<td class="px-4 py-2.5">
			<span data-stock-nombre class="font-medium text-text"></span>
		</td>
		<td class="px-4 py-2.5">
			<span data-stock-categoria class="text-xs text-text-muted"></span>
		</td>
		<td class="px-4 py-2.5">
			<span class="flex flex-wrap items-center gap-1.5">
				<!-- Tags: text + tone, never color alone (stilesbase §5.2). -->
				<span
					data-stock-bajo
					hidden
					class="rounded-full bg-warning px-2 py-0.5 text-xs font-medium text-warning-content"
					>Bajo</span
				>
				<span
					data-stock-agotado
					hidden
					class="rounded-full bg-danger px-2 py-0.5 text-xs font-medium text-danger-content"
					>Agotado</span
				>
			</span>
		</td>
		<!-- hidden lg:table-cell mirrors the Precio column header (hiddenBelowLg). -->
		<td
			data-stock-precio
			class="hidden px-4 py-2.5 text-right font-semibold text-text tabular-nums lg:table-cell"></td>
		<td class="px-4 py-2.5">
			<span class="flex items-center gap-2">
				<!-- Inline restock stepper: local edits until Guardar. -->
				<span data-stock-stepper class="flex items-center gap-1.5">
					<button
						type="button"
						data-stock-step="-1"
						class="btn btn-secondary px-2"
						aria-label="Restar una unidad"
					>
						<Icon name="minus" class="h-5 w-5" />
					</button>
					<input
						data-stock-input
						type="number"
						min="0"
						max="9999"
						step="1"
						inputmode="numeric"
						class="input-field w-20 text-center font-semibold"
					/>
					<button
						type="button"
						data-stock-step="1"
						class="btn btn-secondary px-2"
						aria-label="Sumar una unidad"
					>
						<Icon name="plus" class="h-5 w-5" />
					</button>
				</span>
				<button type="button" data-stock-save="" class="btn btn-primary" disabled>
					<Icon name="save" class="h-4 w-4" />
					Guardar
				</button>
			</span>
		</td>
	</tr>
</template>
