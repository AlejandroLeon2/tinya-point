---
// Page header (refactorUI §2.2 — Fase 1): title + right-side actions slot +
// optional status slot. Replaces the loose <h1> each route used to render —
// the h1 now lives in the LayoutApp TopBar via this component.
// ui/ admission rule: props/slots only — no fetch, no localStorage, no api/.
interface Props {
  title: string;
  class?: string;
}
const { title, class: cls = '' } = Astro.props;
---
<div class={`flex items-center justify-between gap-3 ${cls}`}>
  <h1 class="truncate text-xl font-bold text-text">{title}</h1>
  <div class="flex shrink-0 items-center gap-2">
    <slot name="state" />
    <slot name="actions" />
  </div>
</div>
