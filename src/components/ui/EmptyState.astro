---
// Reusable empty state (doc/extras.md §6): "Todavía no hay productos
// cargados" / "sin resultados de búsqueda" — message comes as a prop.
// ui/ admission rule: props only — no fetch, no localStorage, no api/ imports
// (doc/astrobase.md §3.2).
// `state` is a data-attribute hook for islands to pick WHICH empty state to
// reveal (no fixed ids, astrobase §3.4) — catalog states (islands/catalog)
// and history states (islands/historial); `hidden` sets the build-time
// visibility (shell renders hidden, the island reveals).
// Generic product-box icon (plan-cierre.md Fase 2 / extras.md §4 — never
// leave the space blank): inline SVG, `currentColor` only inheriting
// `text-text-muted` — no new color tokens, no imports.
interface Props {
  mensaje?: string;
  hidden?: boolean;
  state?:
    | 'empty-catalog'
    | 'no-results'
    | 'empty-historial'
    | 'no-date-results'
    | 'venta-notfound'
    | 'stock-ok'
    | 'stock-nodata'
    | 'empty-productos'
    | 'empty-categorias';
}
const { mensaje = 'Todavía no hay productos cargados', hidden = false, state } = Astro.props;
---
<div class="card flex flex-col items-center gap-2 p-8 text-center" data-empty-state={state} hidden={hidden}>
	<svg
		class="h-10 w-10 text-text-muted"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		focusable="false"
	>
		<path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"></path>
		<path d="M3 7.5 12 12l9-4.5M12 12v9"></path>
	</svg>
	<p class="text-base text-text-muted">{mensaje}</p>
	{
		/* Optional CTA (refactorUI §2.2 — Fase 1): only render the wrapper
		   when someone passes an action, so classic empty states keep their
		   exact compact look. */
		Astro.slots.has('actions') && (
			<div class="mt-2 flex flex-wrap justify-center gap-3">
				<slot name="actions" />
			</div>
		)
	}
</div>
