---
// Low-stock panel container (plan-stock.md + refactorUI §9 / plan T3.8) —
// smart layer composes chrome + ui/ and wires islands/stock/stock.ts (astrobase
// §3.3). Read-only over the cached catalog: the restock writes happen in the
// rows themselves (actualizarProducto inline, plan-reponer-buscar Fase 1).
// 2026-11-01 owner pass: the card list became a REUSABLE ui/DataTable
// (desktop, shared with /productos + /historial) + the mobile card twin,
// with a search input (shared utils/search pipeline), chips + a categoría
// select, and prev/next pagination. Controls: ± icon stepper + direct
// number entry ONLY (batch +5/+10/+24 removed) and an explicit "Guardar"
// button per row — edits stay local until saved.
import Alert from '../ui/Alert.astro';
import Chip from '../ui/Chip.astro';
import ChipGroup from '../ui/ChipGroup.astro';
import DataTable from '../ui/DataTable.astro';
import EmptyState from '../ui/EmptyState.astro';
import Icon from '../ui/Icon.astro';
import StatCard from '../ui/StatCard.astro';
import StockRow from '../ui/StockRow.astro';
import StockRowDesktop from '../ui/StockRowDesktop.astro';
---
<section data-stock-root class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-6">
	<!-- The h1 lives in the LayoutApp TopBar (ONE h1 per page, §3.1). -->

	<!-- reposición fallida: error de API con revert del stepper -->
	<Alert tone="warning" name="stock-warning" hidden>
		<span data-stock-warning-text></span>
	</Alert>

	<!-- KPIs (spec §9): reemplazan el párrafo de stats viejo -->
	<div data-stock-kpis class="grid grid-cols-2 gap-3 md:grid-cols-3">
		<StatCard etiqueta="Por reponer" valor="—" data-stock-kpi="reponer" />
		<StatCard etiqueta="Agotados" valor="—" data-stock-kpi="agotados" />
		<StatCard
			etiqueta="Inventario valorizado"
			valor="—"
			data-stock-kpi="valorizado"
			class="col-span-2 md:col-span-1"
		/>
	</div>
	<p data-stock-umbral class="text-xs text-text-muted">
		Mostrando productos con stock menor a 5.
	</p>

	<div class="flex flex-wrap items-center justify-between gap-3">
		<h2 class="text-base font-semibold text-text">Productos por reponer</h2>
		<div class="flex flex-wrap items-center gap-3">
			<!-- "Actualizado hace N min" SIEMPRE junto a Actualizar (spec §9);
			     tono warning cuando la caché superó el TTL. Dos nodos porque
			     el tono viaja como visibilidad, nunca como clases (§0.4). -->
			<p data-stock-stale hidden class="text-base">
				<span data-stock-stale-text class="text-text-muted"></span>
				<span data-stock-stale-warn hidden class="font-semibold text-warning"></span>
			</p>
			<button type="button" data-stock-refresh class="btn btn-secondary">
				Actualizar
			</button>
		</div>
	</div>

	<!-- Search on its own row ALWAYS, filters below — same toolbar layout
	     as /productos (owner request 2026-11-01). Local-only, zero network. -->
	<span class="relative block w-full">
		<Icon
			name="buscar"
			class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-text-muted"
		/>
		<input
			data-stock-search
			type="search"
			class="input-field pl-10"
			placeholder="Buscar por nombre, categoría o marca…"
			aria-label="Buscar productos con stock bajo"
			autocomplete="off"
		/>
	</span>

	<div class="flex flex-wrap items-center gap-3">
		<!-- Filtros (spec §9): el hook vive en el wrapper, los chips llevan
		     el valor — ahora complementados por el select de categoría. -->
		<div data-stock-filter>
			<ChipGroup label="Filtros de stock">
				<Chip data-stock-filter-value="todos" aria-pressed="true">Todos los bajos</Chip>
				<Chip data-stock-filter-value="agotados" aria-pressed="false">Solo agotados</Chip>
			</ChipGroup>
		</div>
		<label class="flex items-center gap-2 text-sm font-medium text-text">
			Categoría
			<select data-stock-catfilter class="input-field max-w-48">
				<option value="">Todas</option>
			</select>
		</label>
	</div>

	<!-- Desktop (≥md): the SHARED DataTable — same component /productos and
	     /historial use. The wrapper carries the hook so the island can hide
	     the empty table alongside the list (a header-only table is noise). -->
	<div data-stock-table-wrap>
		<!-- hiddenBelowLg={[3]} (Precio): 5 columns overflow the md–lg range by
		     66px at 810px (DataTable.astro Props) — price is the least critical
		     cell for restocking; the valorizado KPI keeps the total in view. -->
		<DataTable
			columns={['Producto', 'Categoría', 'Estado', 'Precio', 'Ajuste']}
			hiddenBelowLg={[3]}
		/>
	</div>

	<!-- Mobile (<md): the card twin -->
	<div data-stock-list class="flex flex-col gap-2 md:hidden"></div>

	<StockRow />
	<StockRowDesktop />

	<!-- Visual pagination, 25/page, client-only — island hides it until
	     there is more than one page (same pattern as the POS catalog). -->
	<nav
		data-stock-pagination
		hidden
		aria-label="Paginación de stock"
		class="flex items-center justify-between gap-3"
	>
		<button data-stock-prev type="button" class="btn btn-secondary">Anterior</button>
		<p data-stock-range aria-live="polite" class="text-sm text-text-muted"></p>
		<button data-stock-next type="button" class="btn btn-secondary">Siguiente</button>
	</nav>

	<!-- All good: nothing under the threshold (icon comes with EmptyState) -->
	<EmptyState
		state="stock-ok"
		mensaje="Ningún producto bajo el umbral. ¡Todo en orden!"
		hidden
	/>
	<!-- Search / filter active but nothing matches -->
	<EmptyState
		state="stock-noresults"
		mensaje="Sin resultados para la búsqueda o el filtro actual."
		hidden
	/>
	<!-- No cache AND fetch failed: never invent numbers — Reintentar is a
	     second [data-stock-refresh] trigger (the island delegates). -->
	<EmptyState
		state="stock-nodata"
		mensaje="No se pudo cargar el catálogo. Revisa tu conexión."
		hidden
	>
		<button slot="actions" type="button" data-stock-refresh class="btn btn-secondary">
			Reintentar
		</button>
	</EmptyState>
</section>

<script>
	import '../islands/stock/stock';
</script>
