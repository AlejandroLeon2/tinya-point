---
// Login form container — visual form from ui/, real login call via
// api/actions/auth.ts (doc/astrobase.md §3.3). The submit handler lives in
// islands/login-form.ts (golden rule 4 — reusable client behavior never
// sits inline in a component).
import Button from '../ui/Button.astro';
---
<form data-login-form class="flex flex-col gap-3" novalidate>
	<label class="flex flex-col gap-1 text-base font-semibold">
		Usuario
		<input
			class="input-field"
			type="text"
			name="usuario"
			autocomplete="username"
			required
		/>
	</label>
	<label class="flex flex-col gap-1 text-base font-semibold">
		Contraseña
		<input
			class="input-field"
			type="password"
			name="clave"
			autocomplete="current-password"
			required
		/>
	</label>
	<p data-login-error class="text-base text-danger" role="alert" hidden></p>
	<Button type="submit" variant="primary">Ingresar</Button>
</form>

<script>
	import '../islands/login-form';
</script>
