---
// Ticket container (refactorUI §4.2A/B/C — Fase 2): the ONE ticket panel
// that replaces the old cart-summary + checkout-panel DUPLICATION (D2):
//   - ONE node [data-ticket] (also data-checkout-root for checkout.ts) with
//     header "Ticket (N)" + cancel, ul[data-cart-lines], ONE CartTotals,
//     payment block, quick amounts and COBRAR.
//   - Lives INSIDE Modal variant="ticket": bottom sheet at <lg (opened by
//     CartBar "Ver ticket"), always-visible right column at ≥lg — same DOM,
//     no duplication (§4.2C; visibility ≥lg forced by global.css theme rule).
//   - Lines + totals painted by cart-actions.ts; payment half by checkout.ts.
// Delegates all drawing to ui/ (doc/astrobase.md §3.3). The sale-closure
// ORDER (uuid → local snapshot → local stock → clear cart → immediate sync)
// lives in islands/cart/checkout.ts, which follows base.md §7 literally.
//
// Owner request 2026-11-04: the ticket is TWO STEPS —
//   1. Detalle: lines + Subtotal/IGV/Total + "Continuar al pago".
//   2. Pago: amount to charge + método de pago + recibido/vuelto + COBRAR.
// checkout.ts flips `hidden` on the two panels (no runtime classes, §0.4);
// "Continuar al pago" / "Volver" are the ONLY step navigation (owner request
// 2026-11-04: the 1·2 indicator pills were removed, they added no function).
import Modal from '../ui/Modal.astro';
import CartLine from '../ui/CartLine.astro';
import CartTotals from '../ui/CartTotals.astro';
import CancelSale from '../ui/CancelSale.astro';
import Alert from '../ui/Alert.astro';
import Icon from '../ui/Icon.astro';
import { etiquetaIgv } from '../../utils/tax';

// Build-time default (no localStorage → 18%); cart-actions.ts overwrites it
// with the configured rate at runtime (plan-productos-v2 Fase 5).
const taxLabel = etiquetaIgv();
// Wire values in Spanish (base.md §2.2 / METODOS_PAGO), UI labels in Spanish.
// Real radios (keyboard + AT) styled as big segmented buttons ≥56px (§4.2E).
const metodos = [
	{ value: 'efectivo', label: 'Efectivo', icon: 'venta' },
	{ value: 'tarjeta', label: 'Tarjeta', icon: 'tarjeta' },
	{ value: 'yape-plin', label: 'Yape/Plin', icon: 'celular' },
];
---
<Modal modalKey="ticket" title="Ticket" variant="ticket">
	<section
		data-ticket
		data-checkout-root
		class="flex h-full min-h-0 flex-col gap-3 p-4 lg:p-0"
		aria-label="Ticket de compra"
	>
		<button
			type="button"
			data-ticket-sheet-toggle
			aria-expanded="false"
			aria-label="Expandir ticket"
			title="Expandir ticket"
			class="mx-auto flex h-6 w-14 shrink-0 items-center justify-center lg:hidden"
		>
			<span aria-hidden="true" class="h-1 w-9 rounded-full bg-border"></span>
		</button>

		<!-- Header (§4.2A/G): badge count + cancel as danger OUTLINE — the
		     mobile close ✕ only exists when the modal is a sheet (<lg). -->
		<div class="flex shrink-0 items-center justify-between gap-3">
			<h2 class="text-base font-semibold text-text">
				Ticket (<span data-cart-badge>0</span>)
			</h2>
			<div class="flex shrink-0 items-center gap-2">
				<CancelSale />
				<button
					type="button"
					class="btn btn-secondary min-h-11 px-3 lg:hidden"
					data-modal-close
					aria-label="Cerrar ticket"
				>
					✕
				</button>
			</div>
		</div>

		<!-- ── Step 1 — lines + totals up to Total ─────────────────────── -->
		<div data-checkout-step="1" class="flex min-h-0 flex-1 flex-col gap-3">
			<!-- Lines scroll independently; totals and the step action stay visible. -->
			<ul data-cart-lines class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto"></ul>
			<CartLine />

			<div class="flex shrink-0 flex-col gap-3">
				<CartTotals taxLabel={taxLabel} />
				<button
					type="button"
					data-checkout-continue
					disabled
					class="btn btn-primary min-h-14 w-full text-base font-semibold"
				>
					Continuar al pago
				</button>
			</div>
		</div>

		<!-- ── Step 2 — payment method ─────────────────────────────────── -->
		<div
			data-checkout-step="2"
			hidden
			class="flex min-h-0 flex-1 flex-col gap-3 overflow-hidden"
		>
			<div class="min-h-0 flex-1 space-y-3 overflow-y-auto">
				<button
					type="button"
					data-checkout-back
					class="btn btn-secondary min-h-9 w-fit px-3 text-xs"
				>
					<Icon name="chevron-left" class="h-4 w-4" />
					Volver al detalle
				</button>

			<!-- The same total the charge button carries, kept in view. -->
				<div class="flex items-center justify-between gap-3 rounded-xl border border-border bg-bg px-3.5 py-3">
					<span class="text-sm text-text-muted">Total a cobrar</span>
					<span data-checkout-total-amount class="text-xl font-bold tabular-nums text-text"
						>S/ 0.00</span
					>
				</div>

				<fieldset class="flex flex-col gap-3 rounded-lg border border-border p-3">
				<legend class="px-1 text-sm font-semibold text-text">Método de pago</legend>
				<div role="radiogroup" aria-label="Método de pago" class="grid grid-cols-3 gap-2">
					{
						metodos.map((metodo, index) => (
							<label class="flex min-h-14 cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-center text-sm font-medium text-text has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-content focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary">
								<input
									type="radio"
									name="metodo_pago"
									value={metodo.value}
									checked={index === 0}
									class="sr-only"
								/>
								<Icon name={metodo.icon} class="h-5 w-5" />
								{metodo.label}
							</label>
						))
					}
				</div>

				<!-- Cash only: Recibido → quick amounts → vuelto (base.md §7).
				     Island toggles/fills; the group starts EMPTY (painted by
				     checkout.ts with the current total). -->
				<div data-checkout-cash class="flex flex-col gap-2.5">
					<label class="flex flex-col gap-1 text-sm font-medium text-text">
						Recibido
						<input
							data-checkout-recibido
							type="number"
							min="0"
							step="0.01"
							inputmode="decimal"
							class="input-field"
							placeholder="0.00"
						/>
					</label>
					<div
						data-checkout-quick-group
						role="group"
						aria-label="Montos rápidos"
						class="flex flex-wrap gap-2"
					>
					</div>
					<!-- Two nodes instead of tone-swapping classes at runtime
					     (§0.4: islands flip hidden/text, never classes). -->
					<p
						data-checkout-vuelto
						hidden
						class="flex flex-col items-center gap-0.5 rounded-lg border border-success/50 bg-success/10 p-2.5 text-success"
					>
						<span class="text-sm font-semibold">Vuelto</span>
						<span data-checkout-vuelto-amount class="text-2xl font-bold tabular-nums">S/ 0.00</span>
					</p>
					<p
						data-checkout-faltan
						hidden
						class="rounded-lg border border-warning/50 bg-warning/10 p-2.5 text-center text-sm font-semibold text-warning"
					>
						Faltan <span data-checkout-faltan-amount class="tabular-nums">S/ 0.00</span>
					</p>
				</div>
				</fieldset>
			</div>

			<div class="flex shrink-0 flex-col gap-3">
				<!-- 56px full-width charge (§4.2E); disabled ⇔ empty cart ∨ cash
				     shortfall; the reason rides aria-describedby (single static
				     instance — same status as sidebar-principal). -->
				<button
					type="button"
					data-checkout-charge
					aria-describedby="checkout-reason"
					disabled
					class="btn btn-primary min-h-14 w-full text-base font-semibold"
				>
					Cobrar
				</button>
				<p id="checkout-reason" data-checkout-reason hidden class="text-sm font-medium text-warning">
					Faltan S/ 0.00 para poder cobrar.
				</p>

				<Alert name="checkout-error" tone="danger" hidden>
					No se pudo enviar la venta al Sheet. Quedó guardada en este dispositivo.
				</Alert>
			</div>
		</div>
	</section>
</Modal>

<!-- Sale-closure confirmation (§4.2F): replaces the old success Alert —
     check, total, big change, "Nueva venta" (focus search) / "Ver detalle".
     Autoclose 8 s ONLY when there is no change to show (checkout.ts). -->
<Modal modalKey="venta-ok" title="Venta registrada">
	<div class="flex flex-col items-center gap-3 text-center">
		<span
			class="flex h-14 w-14 items-center justify-center rounded-full bg-success/10 text-success"
		>
			<Icon name="check" class="h-8 w-8" />
		</span>
		<p class="text-sm text-text-muted">Total</p>
		<p data-venta-ok-total class="text-2xl font-bold tabular-nums text-text">S/ 0.00</p>
		<p data-venta-ok-vuelto hidden class="text-sm text-text-muted">
			Vuelto
			<span data-venta-ok-vuelto-amount class="ml-1 text-3xl font-bold tabular-nums text-success"></span>
		</p>
	</div>
	<button slot="actions" type="button" data-venta-ok-nueva class="btn btn-primary">
		Nueva venta
	</button>
	<!-- Imprimir ticket (owner 2026-11-05, rediseño): opens the shared
	     ticket-preview modal — the 58 mm ticket shown ready to print;
	     its "Imprimir" button runs the popup. checkout.ts owns the handler. -->
	<button slot="actions" type="button" data-venta-ok-print class="btn btn-secondary">
		Imprimir ticket
	</button>
	<a slot="actions" data-venta-ok-detail href="/historial/venta/" class="btn btn-secondary">
		Ver detalle
	</a>
</Modal>

<script>
	import '../islands/cart/cart-badge';
	import '../islands/cart/cart-actions';
	import '../islands/runtime/modal-controller';
	import '../islands/cart/checkout';
</script>

<script>
	// Ticket viewport contract (§4.2C): at ≥lg the sheet root is a static
	// column — a column must NOT claim to be a modal dialog. Toggles only
	// aria-modal (visibility ≥lg is owned by the global.css theme rule).
	const root = document.querySelector<HTMLElement>('[data-modal-root="ticket"]');
	const dialog = root?.querySelector<HTMLElement>('[role="dialog"]') ?? null;
	const desktop = window.matchMedia('(min-width: 1024px)');
	const syncAria = (): void => {
		dialog?.setAttribute('aria-modal', desktop.matches ? 'false' : 'true');
	};
	desktop.addEventListener('change', syncAria);
	syncAria();
</script>
