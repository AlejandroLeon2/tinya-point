---
// Ticket container (refactorUI §4.2A/B/C — Fase 2): the ONE ticket panel
// that replaces the old cart-summary + checkout-panel DUPLICATION (D2):
//   - ONE node [data-ticket] (also data-checkout-root for checkout.ts) with
//     header "Ticket (N)" + cancel, ul[data-cart-lines], ONE CartTotals,
//     payment block, quick amounts and COBRAR.
//   - Lives INSIDE Modal variant="ticket": bottom sheet at <lg (opened by
//     CartBar "Ver ticket"), always-visible right column at ≥lg — same DOM,
//     no duplication (§4.2C; visibility ≥lg forced by global.css theme rule).
//   - Lines + totals painted by cart-actions.ts; payment half by checkout.ts.
// Delegates all drawing to ui/ (doc/astrobase.md §3.3). The sale-closure
// ORDER (uuid → local snapshot → local stock → clear cart → immediate sync)
// lives in islands/checkout.ts, which follows base.md §7 literally.
import Modal from '../ui/Modal.astro';
import CartLine from '../ui/CartLine.astro';
import CartTotals from '../ui/CartTotals.astro';
import CancelSale from '../ui/CancelSale.astro';
import Alert from '../ui/Alert.astro';
import Icon from '../ui/Icon.astro';
import { etiquetaIgv } from '../../utils/tax';

// Build-time default (no localStorage → 18%); cart-actions.ts overwrites it
// with the configured rate at runtime (plan-productos-v2 Fase 5).
const taxLabel = etiquetaIgv();
// Wire values in Spanish (base.md §2.2 / METODOS_PAGO), UI labels in Spanish.
// Real radios (keyboard + AT) styled as big segmented buttons ≥56px (§4.2E).
const metodos = [
	{ value: 'efectivo', label: 'Efectivo', icon: 'venta' },
	{ value: 'tarjeta', label: 'Tarjeta', icon: 'tarjeta' },
	{ value: 'yape-plin', label: 'Yape/Plin', icon: 'celular' },
];
---
<Modal modalKey="ticket" title="Ticket" variant="ticket">
	<section
		data-ticket
		data-checkout-root
		class="flex flex-col gap-4 lg:h-full lg:min-h-0"
		aria-label="Ticket de compra"
	>
		<!-- Header (§4.2A/G): badge count + cancel as danger OUTLINE — the
		     mobile close ✕ only exists when the modal is a sheet (<lg). -->
		<div class="flex items-center justify-between gap-3">
			<h2 class="text-xl font-bold text-text">
				Ticket (<span data-cart-badge>0</span>)
			</h2>
			<div class="flex shrink-0 items-center gap-2">
				<CancelSale />
				<button
					type="button"
					class="btn btn-secondary min-h-11 px-3 py-2 lg:hidden"
					data-modal-close
					aria-label="Cerrar ticket"
				>
					✕
				</button>
			</div>
		</div>

		<!-- Lines: scroll zone on desktop (§4.2B) — painted by cart-actions. -->
		<ul data-cart-lines class="flex flex-col gap-3 lg:min-h-0 lg:flex-1 lg:overflow-y-auto"></ul>
		<CartLine />

		<!-- Payment half stays anchored at the bottom of the column (§4.2B). -->
		<div class="flex shrink-0 flex-col gap-4">
			<CartTotals taxLabel={taxLabel} />

			<fieldset class="flex flex-col gap-3 rounded-lg border-2 border-border p-4">
				<legend class="px-1 text-base font-bold text-text">Método de pago</legend>
				<div role="radiogroup" aria-label="Método de pago" class="grid grid-cols-3 gap-2">
					{
						metodos.map((metodo, index) => (
							<label
								class="flex min-h-14 cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border-2 border-border bg-surface px-2 py-2 text-center text-base font-semibold text-text has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-content focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary"
							>
								<input
									type="radio"
									name="metodo_pago"
									value={metodo.value}
									checked={index === 0}
									class="sr-only"
								/>
								<Icon name={metodo.icon} class="h-6 w-6" />
								{metodo.label}
							</label>
						))
					}
				</div>

				<!-- Cash only: Recibido → quick amounts → vuelto (base.md §7).
				     Island toggles/fills; the group starts EMPTY (painted by
				     checkout.ts with the current total). -->
				<div data-checkout-cash class="flex flex-col gap-3">
					<label class="flex flex-col gap-1 text-base font-semibold text-text">
						Recibido
						<input
							data-checkout-recibido
							type="number"
							min="0"
							step="0.01"
							inputmode="decimal"
							class="input-field"
							placeholder="0.00"
						/>
					</label>
					<div
						data-checkout-quick-group
						role="group"
						aria-label="Montos rápidos"
						class="flex flex-wrap gap-2"
					>
					</div>
					<!-- Two nodes instead of tone-swapping classes at runtime
					     (§0.4: islands flip hidden/text, never classes). -->
					<p
						data-checkout-vuelto
						hidden
						class="flex flex-col items-center gap-1 rounded-lg border-2 border-success/50 bg-success/10 p-3 text-success"
					>
						<span class="text-base font-semibold">Vuelto</span>
						<span data-checkout-vuelto-amount class="text-2xl font-bold tabular-nums">S/ 0.00</span>
					</p>
					<p
						data-checkout-faltan
						hidden
						class="rounded-lg border-2 border-warning/50 bg-warning/10 p-3 text-center font-semibold text-warning"
					>
						Faltan <span data-checkout-faltan-amount class="tabular-nums">S/ 0.00</span>
					</p>
				</div>
			</fieldset>

			<!-- 64px full-width charge (§4.2E); disabled ⇔ empty cart ∨ cash
			     shortfall; the reason rides aria-describedby (single static
			     instance — same status as sidebar-principal). -->
			<button
				type="button"
				data-checkout-charge
				aria-describedby="checkout-reason"
				disabled
				class="btn btn-primary min-h-16 w-full text-xl"
			>
				Cobrar
			</button>
			<p id="checkout-reason" data-checkout-reason hidden class="text-base font-semibold text-warning">
				Faltan S/ 0.00 para poder cobrar.
			</p>

			<Alert name="checkout-error" tone="danger" hidden>
				No se pudo enviar la venta al Sheet. Quedó guardada en este dispositivo.
			</Alert>
		</div>
	</section>
</Modal>

<!-- Sale-closure confirmation (§4.2F): replaces the old success Alert —
     check, total, big change, "Nueva venta" (focus search) / "Ver detalle".
     Autoclose 8 s ONLY when there is no change to show (checkout.ts). -->
<Modal modalKey="venta-ok" title="Venta registrada">
	<div class="flex flex-col items-center gap-3 text-center">
		<span
			class="flex h-14 w-14 items-center justify-center rounded-full bg-success/10 text-success"
		>
			<Icon name="check" class="h-8 w-8" />
		</span>
		<p class="text-base text-text-muted">Total</p>
		<p data-venta-ok-total class="text-2xl font-bold tabular-nums text-text">S/ 0.00</p>
		<p data-venta-ok-vuelto hidden class="text-base text-text-muted">
			Vuelto
			<span data-venta-ok-vuelto-amount class="ml-1 text-3xl font-bold tabular-nums text-success"></span>
		</p>
	</div>
	<button slot="actions" type="button" data-venta-ok-nueva class="btn btn-primary">
		Nueva venta
	</button>
	<a slot="actions" data-venta-ok-detail href="/historial/venta/" class="btn btn-secondary">
		Ver detalle
	</a>
</Modal>

<script>
	import '../islands/cart-badge';
	import '../islands/cart-actions';
	import '../islands/modal-controller';
	import '../islands/checkout';
</script>

<script>
	// Ticket viewport contract (§4.2C): at ≥lg the sheet root is a static
	// column — a column must NOT claim to be a modal dialog. Toggles only
	// aria-modal (visibility ≥lg is owned by the global.css theme rule).
	const root = document.querySelector<HTMLElement>('[data-modal-root="ticket"]');
	const dialog = root?.querySelector<HTMLElement>('[role="dialog"]') ?? null;
	const desktop = window.matchMedia('(min-width: 1024px)');
	const syncAria = (): void => {
		dialog?.setAttribute('aria-modal', desktop.matches ? 'false' : 'true');
	};
	desktop.addEventListener('change', syncAria);
	syncAria();
</script>
