---
// Checkout container — gathers cart data, calls api/actions/ventas.ts +
// stock.ts, updates history via utils/storage.ts, clears stores/cart.ts
// (doc/astrobase.md §3.3). Delegates all drawing to ui/: the sale-closure
// ORDER (uuid → local snapshot → local stock → clear cart → immediate sync)
// lives in islands/checkout.ts, which follows base.md §7 literally.
import Alert from '../ui/Alert.astro';
import Button from '../ui/Button.astro';
import CartTotals from '../ui/CartTotals.astro';
import CheckoutLine from '../ui/CheckoutLine.astro';
import { TAX_RATE } from '../../utils/tax';

const taxLabel = `IGV (${Math.round(TAX_RATE * 100)}%)`;
// Wire values in Spanish (base.md §2.2 / METODOS_PAGO), UI labels in Spanish.
const metodos = [
	{ value: 'efectivo', label: 'Efectivo' },
	{ value: 'tarjeta', label: 'Tarjeta' },
	{ value: 'yape-plin', label: 'Yape/Plin' },
];
---
<section data-checkout-root class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-6">
	<h2 class="text-xl font-bold text-text">Cobrar</h2>

	<ul data-checkout-lines class="flex flex-col gap-3"></ul>
	<CheckoutLine />
	<CartTotals taxLabel={taxLabel} />

	<fieldset class="flex flex-col gap-3 rounded-lg border-2 border-border p-4">
		<legend class="px-1 text-base font-bold text-text">Método de pago</legend>
		<div class="flex flex-wrap gap-3">
			{
				metodos.map((metodo, index) => (
					<label class="flex items-center gap-2 text-base text-text">
						<input
							type="radio"
							name="metodo_pago"
							value={metodo.value}
							checked={index === 0}
							class="h-5 w-5 accent-primary"
						/>
						{metodo.label}
					</label>
				))
			}
		</div>
		<!-- Cash only: Recibido → vuelto (base.md §7). Island toggles/fills. -->
		<div data-checkout-cash class="flex flex-col gap-3">
			<label class="flex flex-col gap-1 text-base font-semibold text-text">
				Recibido
				<input
					data-checkout-recibido
					type="number"
					min="0"
					step="0.01"
					inputmode="decimal"
					class="input-field"
					placeholder="0.00"
				/>
			</label>
			<p data-checkout-vuelto hidden class="text-base font-bold text-text"></p>
		</div>
	</fieldset>

	<Button variant="primary" data-checkout-charge disabled>Cobrar venta</Button>

	<Alert name="checkout-success" tone="success" hidden>Venta registrada</Alert>
	<Alert name="checkout-error" tone="danger" hidden>
		No se pudo enviar la venta al Sheet. Quedó guardada en este dispositivo.
	</Alert>
</section>

<script>
	import '../islands/checkout';
</script>
