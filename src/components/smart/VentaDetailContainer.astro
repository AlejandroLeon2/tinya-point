---
// Sale detail container (plan-mejoras-2.md Fase 3, decision D3) — composes
// chrome + ui/ parts and wires islands/venta-detail.ts: meta card (fecha,
// hora, método), one VentaLine per item, totals card (subtotal only when the
// snapshot has it — gotcha G9 —, IGV, total) and the EmptyState for an
// unknown ?id=. Zero API: everything comes from the local historial
// (base.md §7 "del propio dispositivo").
import EmptyState from '../ui/EmptyState.astro';
import VentaLine from '../ui/VentaLine.astro';
import { TAX_RATE } from '../../utils/tax';

// Single source of truth for the rate (utils/tax.ts) — same label assembly
// as smart/CartSummary.
const taxLabel = `IGV (${Math.round(TAX_RATE * 100)}%)`;
---
<section data-venta-root class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-6">
	<h1 class="text-xl font-bold text-text">Detalle de venta</h1>

	<div data-venta-contenido class="flex flex-col gap-4">
		<div class="card flex flex-wrap items-center gap-3 text-base">
			<span data-venta-fecha class="font-semibold text-text"></span>
			<span data-venta-hora class="text-text-muted"></span>
			<span data-venta-metodo class="text-text-muted"></span>
		</div>

		<ul data-venta-lines class="flex flex-col gap-3"></ul>
		<VentaLine />

		<div class="card flex flex-col gap-2 text-base">
			<div data-venta-subtotal-fila class="flex justify-between gap-3" hidden>
				<span class="text-text-muted">Subtotal</span>
				<span data-venta-subtotal class="font-semibold text-text"></span>
			</div>
			<div class="flex justify-between gap-3">
				<span class="text-text-muted">{taxLabel}</span>
				<span data-venta-igv class="font-semibold text-text"></span>
			</div>
			<div class="flex justify-between gap-3">
				<span class="font-bold text-text">Total</span>
				<span data-venta-total class="font-bold text-text"></span>
			</div>
		</div>
	</div>

	<!-- Unknown/absent id → revealed by the island (gotcha G1: the route is
	     static, so "not found" is a runtime state, not a 404 page). -->
	<div data-venta-no-encontrada hidden>
		<EmptyState state="venta-notfound" mensaje="Venta no encontrada" hidden />
	</div>

	<div>
		<a href="/historial" class="btn btn-secondary">Volver al historial</a>
	</div>
</section>

<script>
	import '../islands/venta-detail';
</script>
